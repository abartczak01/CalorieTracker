			"name": "products",
			"item": [
				{
					"name": "Get all products",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"There are 4 elements in db\", function() {",
									"    var jsonData = pm.response.json();",
									"",
									"    pm.expect(jsonData.length).to.eql(4);",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/products/search",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"products",
								"search"
							]
						},
						"description": "This is a GET request and it is used to \"get\" data from an endpoint. There is no request body for a GET request, but you can use query parameters to help specify the resource you want data on (e.g., in this request, we have `id=1`).\n\nA successful GET response will have a `200 OK` status, and should include some kind of response body - for example, HTML web content or JSON data."
					},
					"response": []
				},
				{
					"name": "Get product by id",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Response contains id\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.id).to.eql(\"46c956eb-a2a7-49da-b9cb-02849a2d682f\");\r",
									"});\r",
									"\r",
									"pm.test(\"Response contains valid product name\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.name).to.eql(\"Milk 3.2%\");\r",
									"});\r",
									"\r",
									"pm.test(\"Ingredients are null\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.ingredients).to.eql(null);\r",
									"});\r",
									"\r",
									"pm.test(\"Valid kcal value\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.kcal).to.eql(61);\r",
									"});\r",
									"\r",
									"pm.test(\"Valid protein value\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.protein).to.eql(3.2);\r",
									"});\r",
									"\r",
									"pm.test(\"Valid fat value\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.fat).to.eql(3.2);\r",
									"});\r",
									"\r",
									"pm.test(\"Valid carbohydrate value\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.carbohydrate).to.eql(4.7);\r",
									"});\r",
									"\r",
									"pm.test(\"Valid fiber value\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.fiber).to.eql(0.0);\r",
									"});\r",
									"\r",
									"pm.test(\"Valid sodium value\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.sodium).to.eql(0.05);\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
